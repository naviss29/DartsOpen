generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TournamentStatus {
  /**
   * DARTSOPEN-MONETIZATION-003 (P3) — état transitoire d'un tournoi >10 joueurs créé
   * localement mais dont l'entitlement (crédit tournoi/abonnement) n'est pas encore confirmé
   * par SterPlatform. Ni publiable (jamais de transition directe vers OPEN), ni ouvert aux
   * inscriptions, ni considéré comme autorisé >10 — voir lib/utils/tournamentStatus.ts. Ce
   * n'est qu'une fois l'entitlement confirmé (ou le paiement carrément inexistant, tournoi
   * ≤10) que le tournoi passe en DRAFT.
   */
  PENDING_ENTITLEMENT
  DRAFT
  OPEN
  IN_PROGRESS
  FINISHED
}

enum MatchStatus {
  PENDING
  IN_PROGRESS
  FINISHED
}

enum RegistrationStatus {
  PENDING
  PAID
  CANCELLED
  /**
   * DARTSOPEN-MONETIZATION-004 (P1, contre-audit) — un remboursement a été décidé et demandé à
   * SterPlatform, mais n'est pas encore confirmé financièrement (appel en échec/timeout, ou
   * remboursement Stripe encore asynchrone côté SterPlatform). État intermédiaire obligatoire :
   * REFUNDED ne doit jamais être atteint avant confirmation réelle (voir
   * dbConfirmPendingPayment()/dbMarkRefundConfirmed(), lib/db/tournament.ts). Sûr et réconciliable
   * — n'occupe jamais de place, n'est jamais compté PAID.
   */
  REFUND_PENDING
  /**
   * DARTSOPEN-MONETIZATION-003/004 (P1) — paiement en ligne reçu après coup (webhook tardif)
   * alors que la place n'était plus disponible pour cette inscription (capacité reprise, ou
   * tournoi plus dans un état permettant l'inscription) : jamais transformé en PAID (dépasserait
   * maxPlayers ou honorerait une inscription illégitime), jamais silencieusement ignoré non plus.
   * N'est atteint qu'après confirmation financière réelle du remboursement par SterPlatform —
   * jamais au moment de la simple décision de rembourser (voir REFUND_PENDING ci-dessus).
   */
  REFUNDED
}

enum RegistrationMode {
  ONLINE
  ONSITE
}

/**
 * DARTSOPEN-MONETIZATION-001 — indépendant de RegistrationMode : un tournoi peut être ouvert
 * aux inscriptions en ligne (RegistrationMode.ONLINE) tout en faisant payer sur place
 * (PaymentMode.ONSITE), notamment quand l'organisation n'a pas de Stripe Connect opérationnel.
 * N'a de sens que si entryFee > 0 — ignoré pour un tournoi gratuit.
 */
enum PaymentMode {
  ONLINE
  ONSITE
}

enum ScoringMode {
  ELECTRONIC
  TRADITIONAL
}

enum BracketType {
  SINGLE
  WINNERS
  LOSERS
  GRAND_FINAL
}

/**
 * Liaison entre un organisateur DartsOpen et son organisation BApps Studio (SterPlatform).
 * DartsOpen ne possède plus sa propre notion de compte Stripe (DO-003) : l'encaissement passe
 * exclusivement par SterPlatform, identifié ici par le seul slug de l'organisation.
 */
model Organization {
  userId                String  @id @map("user_id")
  sterOrganizationSlug  String? @map("ster_organization_slug")

  @@map("organizations")
}

model Tournament {
  id                 String           @id @default(uuid())
  userId             String           @map("user_id")
  name               String
  date               DateTime         @db.Date
  location           String
  status             TournamentStatus @default(DRAFT)
  maxPlayers         Int              @map("max_players")
  entryFee           Int              @default(0) @map("entry_fee")
  nbPools            Int              @default(1) @map("nb_pools")
  nbBoards           Int              @default(2) @map("nb_boards")
  advancementPerPool Int              @default(1) @map("advancement_per_pool")
  playersPerTeam     Int              @default(1) @map("players_per_team")
  registrationMode   RegistrationMode @default(ONLINE) @map("registration_mode")
  paymentMode        PaymentMode      @default(ONSITE) @map("payment_mode")
  scoringMode        ScoringMode      @default(ELECTRONIC) @map("scoring_mode")
  quickMode          Boolean          @default(false) @map("quick_mode")
  /**
   * DARTSOPEN-MONETIZATION-002 (audit DO-AUD-001/DO-AUD-002) — stable idempotency key generated
   * once client-side per form instance (not regenerated per request/retry), used both to
   * deduplicate the local row itself (createTournament() upserts on this key: a double-click or
   * network retry with the same key never creates a second tournament) and as the SterPlatform
   * `reference` for tournament-credit consumption (lib/entitlements/tournamentSizeGuard.ts) —
   * decoupled from this row's own `id`, which used to be freshly regenerated on every request,
   * defeating idempotence entirely.
   *
   * DARTSOPEN-MONETIZATION-003 (P4) — scoped to `(userId, idempotencyKey)`, never globally
   * unique: a globally-unique key let a key submitted by user B collide with user A's own key,
   * silently handing B a reference to A's tournament (dbCreateTournament()'s
   * findUnique-by-key/P2002 fallback would return A's row to B). Two different owners using the
   * same key value now simply live in two disjoint namespaces — never a collision, never a
   * rejection needed.
   */
  idempotencyKey     String           @map("idempotency_key")
  createdAt          DateTime         @default(now()) @map("created_at")

  rounds        Round[]
  registrations Registration[]
  pools         Pool[]
  matches       Match[]

  @@unique([userId, idempotencyKey])
  @@index([userId])
  @@map("tournaments")
}

model Round {
  id           String @id @default(uuid())
  tournamentId String @map("tournament_id")
  roundOrder   Int    @map("round_order")
  gameType     String @map("game_type")
  entryType    String @map("entry_type")
  finishType   String @map("finish_type")

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  matchSets  MatchSet[]

  @@index([tournamentId])
  @@map("rounds")
}

model Registration {
  id               String             @id @default(uuid())
  tournamentId     String             @map("tournament_id")
  playerName       String             @map("player_name")
  playerEmail      String             @map("player_email")
  playerPhone      String?            @map("player_phone")
  playerNames      Json               @default("[]") @map("player_names")
  status           RegistrationStatus @default(PENDING)
  qrCodeToken      String             @unique @default(uuid()) @map("qr_code_token")
  sterPaymentId    String?            @map("ster_payment_id")
  entryFeeCents    Int                @default(0) @map("entry_fee_cents")
  platformFeeCents Int                @default(0) @map("platform_fee_cents")
  feeCollected     Boolean            @default(false) @map("fee_collected")
  seeded           Boolean            @default(false)
  lives            Int                @default(2)
  /**
   * DARTSOPEN-MONETIZATION-002 (audit DO-AUD-003/DO-AUD-004/DO-AUD-009) — only ever set for a
   * PENDING registration awaiting online payment: the slot it reserves stops counting toward
   * tournament capacity once this timestamp passes (lazy expiry, see
   * lib/db/tournament.ts::dbReserveRegistrationSlot()), and is never set at all for a
   * PAID registration (free or confirmed onsite — occupies its slot permanently, no expiry).
   */
  reservationExpiresAt DateTime?       @map("reservation_expires_at")
  createdAt        DateTime           @default(now()) @map("created_at")

  tournament  Tournament   @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  poolPlayers PoolPlayer[]
  matchesAsP1 Match[]      @relation("MatchPlayer1")
  matchesAsP2 Match[]      @relation("MatchPlayer2")
  matchesWon  Match[]      @relation("MatchWinner")
  setsWon     MatchSet[]

  @@index([tournamentId])
  @@index([tournamentId, status])
  @@map("registrations")
}

model Pool {
  id           String @id @default(uuid())
  tournamentId String @map("tournament_id")
  name         String

  tournament Tournament   @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  players    PoolPlayer[]
  matches    Match[]

  @@index([tournamentId])
  @@map("pools")
}

model PoolPlayer {
  poolId         String @map("pool_id")
  registrationId String @map("registration_id")
  rank           Int?

  pool         Pool         @relation(fields: [poolId], references: [id], onDelete: Cascade)
  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@id([poolId, registrationId])
  @@index([registrationId])
  @@map("pool_players")
}

model Match {
  id              String      @id @default(uuid())
  tournamentId    String      @map("tournament_id")
  poolId          String?     @map("pool_id")
  bracketRound    Int?        @map("bracket_round")
  bracketPosition Int?        @map("bracket_position")
  boardNumber     Int         @default(0) @map("board_number")
  bracketType     BracketType @default(SINGLE) @map("bracket_type")
  status          MatchStatus @default(PENDING)
  player1Id       String      @map("player1_id")
  player2Id       String?     @map("player2_id")
  winnerId        String?     @map("winner_id")
  /**
   * DO-SPORT-001 — garde d'idempotence pour l'avancement du tournoi rapide
   * (doAdvanceQuickTournament, perte de vie + création des matchs suivants) : posé une seule
   * fois, sous le verrou tournoi, au moment où CE match terminé est effectivement traité.
   * Un rejeu (retry réseau, double appel) de l'avancement pour le même match devient un no-op
   * explicite plutôt qu'une seconde perte de vie ou une double création de matchs suivants.
   * Toujours null en mode standard (l'avancement de bracket a sa propre garde, voir
   * lib/actions/bracket.ts::doAdvanceToNextRound).
   */
  quickAdvanceProcessedAt DateTime? @map("quick_advance_processed_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  tournament Tournament   @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  pool       Pool?        @relation(fields: [poolId], references: [id])
  player1    Registration  @relation("MatchPlayer1", fields: [player1Id], references: [id])
  player2    Registration? @relation("MatchPlayer2", fields: [player2Id], references: [id])
  winner     Registration? @relation("MatchWinner", fields: [winnerId], references: [id])
  sets       MatchSet[]

  @@index([tournamentId])
  @@index([tournamentId, bracketRound])
  @@index([tournamentId, poolId, status])
  @@index([poolId])
  // DO-SPORT-001 — deux contraintes d'unicité partielles (index PostgreSQL filtrés, ajoutées
  // en migration SQL manuscrite — non représentables par la syntaxe @@unique de Prisma) :
  // 1. au plus un match IN_PROGRESS par (tournoi, cible réelle) — une cible ne peut jamais
  //    avoir deux matchs actifs, même sous une course entre deux affectations concurrentes ;
  // 2. au plus un match par (tournoi, type de bracket, round, position) hors matchs de poule —
  //    empêche la création en double d'un même tour/slot de bracket sous concurrence, filet de
  //    sécurité derrière le verrou applicatif (withTournamentLock), jamais le seul mécanisme.
  // Voir la migration dédiée pour le SQL exact.
  @@map("matches")
}

model MatchSet {
  id          String  @id @default(uuid())
  matchId     String  @map("match_id")
  roundId     String  @map("round_id")
  scoreP1     Int     @default(0) @map("score_p1")
  scoreP2     Int     @default(0) @map("score_p2")
  winnerId    String? @map("winner_id")
  validatedP1 Boolean @default(false) @map("validated_p1")
  validatedP2 Boolean @default(false) @map("validated_p2")

  match  Match        @relation(fields: [matchId], references: [id], onDelete: Cascade)
  round  Round        @relation(fields: [roundId], references: [id])
  winner Registration? @relation(fields: [winnerId], references: [id])

  @@index([matchId])
  @@map("match_sets")
}

/// SEC-005 — compteur de rate limiting partagé entre toutes les instances (remplace la Map en
/// mémoire de lib/rateLimit.ts, qui ne survivait ni à un redémarrage ni à une réplication
/// horizontale). `key` est un hash SHA-256 de "route:ip" — jamais l'IP en clair : cette table
/// est durable (contrairement à la Map précédente), la minimisation des données personnelles
/// s'applique. Une ligne par (route, IP) tant que la fenêtre est active ; nettoyée
/// opportunistement (voir lib/rateLimit.ts), jamais par un scheduler dédié.
model RateLimitBucket {
  key     String   @id
  count   Int
  resetAt DateTime @map("reset_at")

  @@index([resetAt])
  @@map("rate_limit_buckets")
}
