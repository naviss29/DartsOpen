# Base de données PostgreSQL locale (docker-compose.yml expose le port 5433)
DATABASE_URL="postgresql://dartsopen:dartsopen@localhost:5433/dartsopen"

# SterPlatform — auth, organisations, email et paiements
NEXT_PUBLIC_API_URL="http://localhost:8080"
STER_ORG_SLUG="dartsopen"
NEXT_PUBLIC_STER_ORG_SLUG="dartsopen"
STER_API_TOKEN="token_applicatif_a_generer"
STER_PAYMENTS_CALLBACK_SECRET="secret_webhook_paiements_a_generer"

# SSO central — doit correspondre à SSO_CLIENT_SECRET_DARTSOPEN côté SterPlatform
STER_SSO_CLIENT_SECRET="secret_sso_a_generer"

# Portail BApps Studio et URL publique de l'application
NEXT_PUBLIC_BSSITE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3002"

# Mercure local (le secret doit correspondre à celui de docker-compose.yml)
NEXT_PUBLIC_MERCURE_PUBLIC_URL="http://localhost:9090/.well-known/mercure"
MERCURE_PRIVATE_URL="http://localhost:9090/.well-known/mercure"
MERCURE_JWT_SECRET="dartsopen-mercure-dev-secret"
